"""
Library Management System - Minimal GUI version
--------------------------------------------------
A simple, button-based (no numbered menu) desktop GUI for the Library
Management System, built with Python's built-in Tkinter library and an
SQLite database (via Python's built-in sqlite3 module).

Dates are never typed manually - every date field is a small popup
calendar you click to pick a day (built from scratch with Tkinter +
Python's standard `calendar` module, no extra libraries required).

Run:
    python library_gui.py

Database file "library.db" is created automatically in the same folder.

Note (Linux only): if you see "No module named 'tkinter'", install it with:
    sudo apt-get install python3-tk
Tkinter ships built-in with the standard Python installers on Windows/Mac.
"""

import calendar
import sqlite3
import tkinter as tk
from tkinter import ttk, messagebox
from datetime import date

DB_NAME = "library.db"


# ---------------------------------------------------------------------------
# Database layer (same schema/logic as the CLI version)
# ---------------------------------------------------------------------------

def get_connection():
    conn = sqlite3.connect(DB_NAME)
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def initialize_database():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS books (
            book_id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            author TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS borrow_records (
            record_id INTEGER PRIMARY KEY AUTOINCREMENT,
            book_id INTEGER NOT NULL,
            student_name TEXT NOT NULL,
            student_class TEXT NOT NULL,
            borrow_date TEXT NOT NULL,
            return_date TEXT,
            FOREIGN KEY (book_id) REFERENCES books (book_id)
        )
    """)

    conn.commit()
    conn.close()


def add_book_db(name, author):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO books (name, author) VALUES (?, ?)", (name, author))
    conn.commit()
    conn.close()


def get_all_books_db():
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT book_id, name, author FROM books ORDER BY name")
    rows = cursor.fetchall()
    conn.close()
    return rows


def find_books_by_name_db(name):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute(
        "SELECT book_id, name, author FROM books WHERE name LIKE ? ORDER BY name",
        (f"%{name}%",)
    )
    rows = cursor.fetchall()
    conn.close()
    return rows


def get_open_records_for_book_db(book_id):
    """Records for this book that have not been returned yet."""
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT record_id, student_name, student_class, borrow_date
        FROM borrow_records
        WHERE book_id = ? AND return_date IS NULL
        ORDER BY borrow_date
    """, (book_id,))
    rows = cursor.fetchall()
    conn.close()
    return rows


def borrow_book_db(book_id, student_name, student_class, borrow_date):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        INSERT INTO borrow_records
            (book_id, student_name, student_class, borrow_date, return_date)
        VALUES (?, ?, ?, ?, NULL)
    """, (book_id, student_name, student_class, borrow_date))
    conn.commit()
    conn.close()


def return_book_db(record_id, return_date):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute(
        "UPDATE borrow_records SET return_date = ? WHERE record_id = ?",
        (return_date, record_id)
    )
    conn.commit()
    conn.close()


def get_history_for_book_db(book_id):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT record_id, student_name, student_class, borrow_date, return_date
        FROM borrow_records
        WHERE book_id = ?
        ORDER BY borrow_date
    """, (book_id,))
    rows = cursor.fetchall()
    conn.close()
    return rows


def search_by_student_db(name):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT r.record_id, b.name, b.author, r.student_name, r.student_class,
               r.borrow_date, r.return_date
        FROM borrow_records r
        JOIN books b ON b.book_id = r.book_id
        WHERE r.student_name LIKE ?
        ORDER BY r.borrow_date
    """, (f"%{name}%",))
    rows = cursor.fetchall()
    conn.close()
    return rows


def get_full_history_db():
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT r.record_id, b.name, b.author, r.student_name, r.student_class,
               r.borrow_date, r.return_date
        FROM borrow_records r
        JOIN books b ON b.book_id = r.book_id
        ORDER BY r.borrow_date
    """)
    rows = cursor.fetchall()
    conn.close()
    return rows


def get_borrow_record_by_id_db(record_id):
    """Full details for one borrow record, joined with its book. None if not found."""
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT r.record_id, r.book_id, b.name, b.author,
               r.student_name, r.student_class, r.borrow_date, r.return_date
        FROM borrow_records r
        JOIN books b ON b.book_id = r.book_id
        WHERE r.record_id = ?
    """, (record_id,))
    row = cursor.fetchone()
    conn.close()
    return row


def update_borrow_record_db(record_id, student_name, student_class, borrow_date, return_date):
    """return_date may be None to mark the book as not yet returned."""
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("""
        UPDATE borrow_records
        SET student_name = ?, student_class = ?, borrow_date = ?, return_date = ?
        WHERE record_id = ?
    """, (student_name, student_class, borrow_date, return_date, record_id))
    conn.commit()
    conn.close()


def delete_borrow_record_db(record_id):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("DELETE FROM borrow_records WHERE record_id = ?", (record_id,))
    conn.commit()
    conn.close()


def get_book_by_id_db(book_id):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT book_id, name, author FROM books WHERE book_id = ?", (book_id,))
    row = cursor.fetchone()
    conn.close()
    return row


def update_book_db(book_id, name, author):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute(
        "UPDATE books SET name = ?, author = ? WHERE book_id = ?",
        (name, author, book_id)
    )
    conn.commit()
    conn.close()


def get_borrow_count_for_book_db(book_id):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM borrow_records WHERE book_id = ?", (book_id,))
    count = cursor.fetchone()[0]
    conn.close()
    return count


def delete_book_db(book_id):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("DELETE FROM books WHERE book_id = ?", (book_id,))
    conn.commit()
    conn.close()


# ---------------------------------------------------------------------------
# Popup calendar widget (no external libraries needed)
# ---------------------------------------------------------------------------

class CalendarPopup(tk.Toplevel):
    """A small popup window showing one month at a time; click a day to pick it."""

    def __init__(self, parent, on_select, initial_date=None):
        super().__init__(parent)
        self.on_select = on_select
        self.title("Select date")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()

        start = initial_date or date.today()
        self.year = start.year
        self.month = start.month

        header = ttk.Frame(self, padding=6)
        header.pack(fill="x")

        ttk.Button(header, text="<", width=3, command=self.prev_month).pack(side="left")
        self.label_var = tk.StringVar()
        ttk.Label(header, textvariable=self.label_var, width=16,
                  anchor="center", font=("TkDefaultFont", 10, "bold")).pack(side="left", expand=True)
        ttk.Button(header, text=">", width=3, command=self.next_month).pack(side="left")

        self.days_frame = ttk.Frame(self, padding=(6, 0, 6, 6))
        self.days_frame.pack()

        self.draw_calendar()

    def draw_calendar(self):
        for widget in self.days_frame.winfo_children():
            widget.destroy()

        self.label_var.set(f"{calendar.month_name[self.month]} {self.year}")

        weekday_names = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]
        for col, wd in enumerate(weekday_names):
            ttk.Label(self.days_frame, text=wd, width=4, anchor="center").grid(
                row=0, column=col, padx=1, pady=1
            )

        weeks = calendar.monthcalendar(self.year, self.month)
        today = date.today()
        for row, week in enumerate(weeks, start=1):
            for col, day in enumerate(week):
                if day == 0:
                    ttk.Label(self.days_frame, text="", width=4).grid(
                        row=row, column=col, padx=1, pady=1
                    )
                    continue
                is_today = (day == today.day and self.month == today.month
                            and self.year == today.year)
                btn = tk.Button(
                    self.days_frame, text=str(day), width=3,
                    relief="solid" if is_today else "flat",
                    command=lambda d=day: self.select_day(d)
                )
                btn.grid(row=row, column=col, padx=1, pady=1)

    def prev_month(self):
        self.month -= 1
        if self.month == 0:
            self.month = 12
            self.year -= 1
        self.draw_calendar()

    def next_month(self):
        self.month += 1
        if self.month == 13:
            self.month = 1
            self.year += 1
        self.draw_calendar()

    def select_day(self, day):
        chosen = date(self.year, self.month, day)
        self.on_select(chosen.isoformat())
        self.destroy()


class DateEntry(ttk.Frame):
    """A read-only date field + a small button that opens the popup calendar."""

    def __init__(self, parent, initial=None):
        super().__init__(parent)
        self.var = tk.StringVar(value=initial or date.today().isoformat())
        self.entry = ttk.Entry(self, textvariable=self.var, width=12, state="readonly")
        self.entry.pack(side="left")
        self.btn = ttk.Button(self, text="📅", width=3, command=self.open_calendar)
        self.btn.pack(side="left", padx=(4, 0))

    def open_calendar(self):
        try:
            current = date.fromisoformat(self.var.get())
        except ValueError:
            current = date.today()
        CalendarPopup(self, self.set_date, initial_date=current)

    def set_date(self, date_str):
        self.var.set(date_str)

    def get(self):
        return self.var.get()


# ---------------------------------------------------------------------------
# Helper: right-click binding that works across Windows/Linux/Mac
# ---------------------------------------------------------------------------

def bind_right_click(widget, handler):
    widget.bind("<Button-3>", handler)       # Windows / Linux
    widget.bind("<Button-2>", handler)       # macOS (two-finger / secondary click)
    widget.bind("<Control-Button-1>", handler)  # macOS one-button-mouse fallback


# ---------------------------------------------------------------------------
# Editable results table (Treeview) used by search dialogs & full history.
# Right-click a row to Edit or Delete that borrow record.
# ---------------------------------------------------------------------------

class HistoryTable(ttk.Frame):
    """records fetched via fetch_func(): (record_id, book, author, student,
    class, borrowed, returned). record_id is None for placeholder
    'no history yet' rows, which can't be edited/deleted."""

    def __init__(self, parent, fetch_func):
        super().__init__(parent)
        self.fetch_func = fetch_func
        self.tree = None
        self.build()

    def build(self):
        for widget in self.winfo_children():
            widget.destroy()

        records = self.fetch_func()

        columns = ("book", "author", "student", "class", "borrowed", "returned")
        self.tree = ttk.Treeview(self, columns=columns, show="headings", height=12)

        headings = {
            "book": "Book", "author": "Author", "student": "Borrower",
            "class": "Class", "borrowed": "Borrowed", "returned": "Returned",
        }
        widths = {
            "book": 160, "author": 130, "student": 110,
            "class": 70, "borrowed": 90, "returned": 90,
        }
        for col in columns:
            self.tree.heading(col, text=headings[col])
            self.tree.column(col, width=widths[col], anchor="w")

        for idx, (record_id, book, author, student, sclass, bdate, rdate) in enumerate(records):
            iid = f"r{record_id}" if record_id is not None else f"n{idx}"
            self.tree.insert("", "end", iid=iid, values=(
                book, author, student, sclass, bdate, rdate or "not returned"
            ))

        scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        bind_right_click(self.tree, self.show_context_menu)

    def show_context_menu(self, event):
        iid = self.tree.identify_row(event.y)
        if not iid or not iid.startswith("r"):
            return  # empty area, or a placeholder "no history" row
        self.tree.selection_set(iid)
        record_id = int(iid[1:])

        menu = tk.Menu(self, tearoff=0)
        menu.add_command(label="Edit...", command=lambda: self.edit_record(record_id))
        menu.add_command(label="Delete", command=lambda: self.delete_record(record_id))
        menu.tk_popup(event.x_root, event.y_root)

    def edit_record(self, record_id):
        EditRecordDialog(self, record_id, on_saved=self.build)

    def delete_record(self, record_id):
        record = get_borrow_record_by_id_db(record_id)
        if not record:
            return
        _, _, book_name, _, student_name, *_ = record
        if messagebox.askyesno(
            "Confirm delete",
            f'Delete the borrow record for "{book_name}" ({student_name})? '
            "This cannot be undone."
        ):
            delete_borrow_record_db(record_id)
            self.build()


class EditRecordDialog(tk.Toplevel):
    """Edit a borrow record's student name, class, borrow date, and return date."""

    def __init__(self, parent, record_id, on_saved):
        super().__init__(parent)
        self.record_id = record_id
        self.on_saved = on_saved
        self.title("Edit Borrow Record")
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()

        record = get_borrow_record_by_id_db(record_id)
        if not record:
            self.destroy()
            return
        (_, self.book_id, book_name, author,
         student_name, student_class, borrow_date, return_date) = record

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book:").grid(row=0, column=0, sticky="e", pady=4)
        ttk.Label(form, text=f"{book_name} (by {author})").grid(
            row=0, column=1, sticky="w", pady=4
        )

        ttk.Label(form, text="Student name:").grid(row=1, column=0, sticky="e", pady=4)
        self.student_var = tk.StringVar(value=student_name)
        ttk.Entry(form, textvariable=self.student_var, width=30).grid(row=1, column=1, pady=4)

        ttk.Label(form, text="Student class:").grid(row=2, column=0, sticky="e", pady=4)
        self.class_var = tk.StringVar(value=student_class)
        ttk.Entry(form, textvariable=self.class_var, width=30).grid(row=2, column=1, pady=4)

        ttk.Label(form, text="Borrow date:").grid(row=3, column=0, sticky="e", pady=4)
        self.borrow_date_entry = DateEntry(form, initial=borrow_date)
        self.borrow_date_entry.grid(row=3, column=1, sticky="w", pady=4)

        self.returned_var = tk.BooleanVar(value=bool(return_date))
        ttk.Checkbutton(
            form, text="Returned", variable=self.returned_var,
            command=self.toggle_return_date
        ).grid(row=4, column=0, sticky="e", pady=4)
        self.return_date_entry = DateEntry(form, initial=return_date)
        self.return_date_entry.grid(row=4, column=1, sticky="w", pady=4)
        self.toggle_return_date()

        button_row = ttk.Frame(form)
        button_row.grid(row=5, column=0, columnspan=2, pady=(10, 0))
        ttk.Button(button_row, text="Save", command=self.save).pack(side="left", padx=4)
        ttk.Button(button_row, text="Cancel", command=self.destroy).pack(side="left", padx=4)

    def toggle_return_date(self):
        if self.returned_var.get():
            self.return_date_entry.entry.configure(state="readonly")
            self.return_date_entry.btn.configure(state="normal")
        else:
            self.return_date_entry.entry.configure(state="disabled")
            self.return_date_entry.btn.configure(state="disabled")

    def save(self):
        student_name = self.student_var.get().strip()
        student_class = self.class_var.get().strip()
        if not student_name or not student_class:
            messagebox.showwarning("Missing info", "Student name and class cannot be empty.")
            return

        return_date = self.return_date_entry.get() if self.returned_var.get() else None

        update_borrow_record_db(
            self.record_id, student_name, student_class,
            self.borrow_date_entry.get(), return_date
        )
        self.on_saved()
        self.destroy()


