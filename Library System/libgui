class ListAllBooksDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("All Books")
        self.geometry("400x430")
        self.transient(parent)

        self.frame = ttk.Frame(self, padding=10)
        self.frame.pack(fill="both", expand=True)

        self.build_table()

    def build_table(self):
        for widget in self.frame.winfo_children():
            widget.destroy()

        books = get_all_books_db()
        if not books:
            ttk.Label(self.frame, text="No books in the library yet.").pack(pady=20)
            return

        ttk.Label(self.frame, text="Right-click a row to edit or delete a book.",
                  font=("TkDefaultFont", 8)).pack(anchor="w")

        table_area = ttk.Frame(self.frame)
        table_area.pack(fill="both", expand=True, pady=(4, 0))

        self.tree = ttk.Treeview(table_area, columns=("name", "author"),
                                  show="headings", height=15)
        self.tree.heading("name", text="Book Name")
        self.tree.heading("author", text="Author")
        self.tree.column("name", width=220)
        self.tree.column("author", width=150)
        for book_id, name, author in books:
            self.tree.insert("", "end", iid=f"b{book_id}", values=(name, author))

        scrollbar = ttk.Scrollbar(table_area, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        bind_right_click(self.tree, self.show_context_menu)

    def show_context_menu(self, event):
        iid = self.tree.identify_row(event.y)
        if not iid:
            return
        self.tree.selection_set(iid)
        book_id = int(iid[1:])

        menu = tk.Menu(self, tearoff=0)
        menu.add_command(label="Edit...", command=lambda: self.edit_book(book_id))
        menu.add_command(label="Delete", command=lambda: self.delete_book(book_id))
        menu.tk_popup(event.x_root, event.y_root)

    def edit_book(self, book_id):
        EditBookDialog(self, book_id, on_saved=self.build_table)

    def delete_book(self, book_id):
        count = get_borrow_count_for_book_db(book_id)
        if count > 0:
            messagebox.showwarning(
                "Cannot delete",
                f"This book has {count} borrow record(s) attached to it. "
                "Delete those records first (via Search by Book or Full History), "
                "then delete the book."
            )
            return
        book = get_book_by_id_db(book_id)
        book_name = book[1] if book else "this book"
        if messagebox.askyesno("Confirm delete", f'Delete "{book_name}" permanently?'):
            delete_book_db(book_id)
            self.build_table()


