class AddBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Add a New Book")
        self.resizable(False, False)
        self.transient(parent)

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book name:").grid(row=0, column=0, sticky="e", pady=4)
        self.name_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.name_var, width=30).grid(row=0, column=1, pady=4)

        ttk.Label(form, text="Author:").grid(row=1, column=0, sticky="e", pady=4)
        self.author_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.author_var, width=30).grid(row=1, column=1, pady=4)

        ttk.Button(form, text="Add Book", command=self.save).grid(
            row=2, column=0, columnspan=2, pady=(10, 0)
        )

    def save(self):
        name = self.name_var.get().strip()
        author = self.author_var.get().strip()
        if not name or not author:
            messagebox.showwarning("Missing info", "Please enter both a book name and an author.")
            return
        add_book_db(name, author)
        messagebox.showinfo("Success", f'"{name}" by {author} added to the library.')
        self.name_var.set("")
        self.author_var.set("")


class BorrowBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Borrow a Book")
        self.resizable(False, False)
        self.transient(parent)

        self.books = get_all_books_db()
        self.all_book_labels = [f"{name} (by {author})" for _, name, author in self.books]
        self.label_to_book = dict(zip(self.all_book_labels, self.books))

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book:").grid(row=0, column=0, sticky="e", pady=4)
        self.book_var = tk.StringVar()
        self.book_combo = ttk.Combobox(form, textvariable=self.book_var,
                                        values=self.all_book_labels, width=32)
        self.book_combo.grid(row=0, column=1, pady=4)
        self.book_combo.bind("<<ComboboxSelected>>", self.check_availability)
        self.book_combo.bind("<KeyRelease>", self.filter_books)
        self.book_combo.bind("<FocusOut>", self.check_availability)

        book_labels = self.all_book_labels
        ttk.Label(form, text="(type to filter, or click the dropdown arrow)",
                  font=("TkDefaultFont", 8)).grid(row=1, column=1, sticky="w")

        self.status_var = tk.StringVar()
        self.status_label = ttk.Label(form, textvariable=self.status_var, foreground="red")
        self.status_label.grid(row=2, column=0, columnspan=2, sticky="w")

        ttk.Label(form, text="Student name:").grid(row=3, column=0, sticky="e", pady=4)
        self.student_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.student_var, width=30).grid(row=3, column=1, pady=4)

        ttk.Label(form, text="Student class:").grid(row=4, column=0, sticky="e", pady=4)
        self.class_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.class_var, width=30).grid(row=4, column=1, pady=4)

        ttk.Label(form, text="Borrow date:").grid(row=5, column=0, sticky="e", pady=4)
        self.date_entry = DateEntry(form)
        self.date_entry.grid(row=5, column=1, sticky="w", pady=4)

        self.save_button = ttk.Button(form, text="Log Borrow", command=self.save)
        self.save_button.grid(row=6, column=0, columnspan=2, pady=(10, 0))

        if book_labels:
            self.book_combo.current(0)
            self.check_availability()
        else:
            messagebox.showinfo("No books", "There are no books in the library yet. Add one first.")

    def filter_books(self, event=None):
        """Narrow the dropdown list to labels containing the typed text."""
        typed = self.book_var.get().strip().lower()
        if typed:
            filtered = [label for label in self.all_book_labels if typed in label.lower()]
        else:
            filtered = self.all_book_labels
        self.book_combo["values"] = filtered

    def get_selected_book(self):
        return self.label_to_book.get(self.book_var.get())

    def check_availability(self, event=None):
        """Show 'not yet returned' if the selected book currently has an open loan."""
        selection = self.get_selected_book()
        if not selection:
            self.status_var.set('Type or select an exact book from the list above.')
            self.status_label.configure(foreground="red")
            self.save_button.state(["disabled"])
            return
        book_id, book_name, _ = selection
        open_records = get_open_records_for_book_db(book_id)

        if open_records:
            _, sname, sclass, bdate = open_records[0]
            self.status_var.set(
                f'Not yet returned - currently with {sname} ({sclass}), borrowed {bdate}.'
            )
            self.save_button.state(["disabled"])
        else:
            self.status_var.set("Available.")
            self.status_label.configure(foreground="green")
            self.save_button.state(["!disabled"])
            return
        self.status_label.configure(foreground="red")

    def save(self):
        if not self.books:
            return
        selection = self.get_selected_book()
        if not selection:
            messagebox.showwarning(
                "No book selected",
                "Please type or select an exact book name from the dropdown list."
            )
            return

        book_id, book_name, _ = selection

        # Guard against double-borrowing even if the status label was bypassed.
        if get_open_records_for_book_db(book_id):
            messagebox.showwarning("Not yet returned",
                                    f'"{book_name}" is not yet returned and cannot be borrowed.')
            self.check_availability()
            return

        student_name = self.student_var.get().strip()
        student_class = self.class_var.get().strip()
        if not student_name or not student_class:
            messagebox.showwarning("Missing info", "Please enter the student's name and class.")
            return

        borrow_book_db(book_id, student_name, student_class, self.date_entry.get())
        messagebox.showinfo(
            "Success",
            f'"{book_name}" borrowed by {student_name} ({student_class}) '
            f'on {self.date_entry.get()}.'
        )
        self.student_var.set("")
        self.class_var.set("")
        self.check_availability()


class ReturnBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Return a Book")
        self.resizable(False, False)
        self.transient(parent)

        self.books = get_all_books_db()
        self.all_book_labels = [f"{name} (by {author})" for _, name, author in self.books]
        self.label_to_book = dict(zip(self.all_book_labels, self.books))

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book:").grid(row=0, column=0, sticky="e", pady=4)
        self.book_var = tk.StringVar()
        self.book_combo = ttk.Combobox(form, textvariable=self.book_var,
                                        values=self.all_book_labels, width=32)
        self.book_combo.grid(row=0, column=1, pady=4)
        self.book_combo.bind("<<ComboboxSelected>>", self.refresh_students)
        self.book_combo.bind("<KeyRelease>", self.filter_books)
        self.book_combo.bind("<FocusOut>", self.refresh_students)

        ttk.Label(form, text="(type to filter, or click the dropdown arrow)",
                  font=("TkDefaultFont", 8)).grid(row=1, column=1, sticky="w")

        ttk.Label(form, text="Borrowed by:").grid(row=2, column=0, sticky="e", pady=4)
        self.record_var = tk.StringVar()
        self.record_combo = ttk.Combobox(form, textvariable=self.record_var,
                                          width=32, state="readonly")
        self.record_combo.grid(row=2, column=1, pady=4)

        ttk.Label(form, text="Return date:").grid(row=3, column=0, sticky="e", pady=4)
        self.date_entry = DateEntry(form)
        self.date_entry.grid(row=3, column=1, sticky="w", pady=4)

        ttk.Button(form, text="Log Return", command=self.save).grid(
            row=4, column=0, columnspan=2, pady=(10, 0)
        )

        self.open_records = []
        self.label_to_record = {}
        if self.all_book_labels:
            self.book_combo.current(0)
            self.refresh_students()
        else:
            messagebox.showinfo("No books", "There are no books in the library yet.")

    def filter_books(self, event=None):
        """Narrow the dropdown list to labels containing the typed text."""
        typed = self.book_var.get().strip().lower()
        if typed:
            filtered = [label for label in self.all_book_labels if typed in label.lower()]
        else:
            filtered = self.all_book_labels
        self.book_combo["values"] = filtered

    def refresh_students(self, event=None):
        selection = self.label_to_book.get(self.book_var.get())
        if not selection:
            self.record_combo["values"] = []
            self.record_var.set("")
            self.open_records = []
            self.label_to_record = {}
            return

        book_id = selection[0]
        self.open_records = get_open_records_for_book_db(book_id)
        labels = [f"{sname} ({sclass}) - borrowed {bdate}"
                  for _, sname, sclass, bdate in self.open_records]
        self.label_to_record = dict(zip(labels, self.open_records))
        self.record_combo["values"] = labels
        if labels:
            self.record_combo.current(0)
        else:
            self.record_var.set("")

    def save(self):
        record = self.label_to_record.get(self.record_var.get())
        if not record:
            messagebox.showwarning("Nothing to return",
                                    "This book has no outstanding (un-returned) loans.")
            return
        record_id, student_name, student_class, _ = record
        return_book_db(record_id, self.date_entry.get())
        messagebox.showinfo(
            "Success",
            f'Return logged for {student_name} ({student_class}) on {self.date_entry.get()}.'
        )
        self.refresh_students()


class SearchByBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Search by Book Name")
        self.geometry("620x400")
        self.transient(parent)

        top = ttk.Frame(self, padding=10)
        top.pack(fill="x")
        ttk.Label(top, text="Book name:").pack(side="left")
        self.query_var = tk.StringVar()
        entry = ttk.Entry(top, textvariable=self.query_var, width=30)
        entry.pack(side="left", padx=6)
        entry.bind("<Return>", lambda e: self.search())
        ttk.Button(top, text="Search", command=self.search).pack(side="left")

        ttk.Label(self, text="Right-click a result row to edit or delete that record.",
                  font=("TkDefaultFont", 8)).pack(anchor="w", padx=10)

        self.results_frame = ttk.Frame(self, padding=(10, 0, 10, 10))
        self.results_frame.pack(fill="both", expand=True)

        entry.focus()

    def search(self):
        for widget in self.results_frame.winfo_children():
            widget.destroy()

        self.current_query = self.query_var.get().strip()
        matches = find_books_by_name_db(self.current_query)
        if not matches:
            ttk.Label(self.results_frame,
                      text=f'No book found matching "{self.current_query}".').pack(pady=20)
            return

        table = HistoryTable(self.results_frame, fetch_func=self.fetch_records)
        table.pack(fill="both", expand=True)

    def fetch_records(self):
        matches = find_books_by_name_db(self.current_query)
        flattened = []
        for book_id, name, author in matches:
            history = get_history_for_book_db(book_id)
            if not history:
                flattened.append((None, name, author, "-", "-", "-", None))
            for record_id, sname, sclass, bdate, rdate in history:
                flattened.append((record_id, name, author, sname, sclass, bdate, rdate))
        return flattened


