# Main window
# ---------------------------------------------------------------------------

class LibraryApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Library Management System")
        self.resizable(False, False)

        ttk.Label(
            self, text="Library Management System",
            font=("TkDefaultFont", 14, "bold")
        ).pack(padx=20, pady=(20, 10))

        buttons = ttk.Frame(self, padding=(20, 0, 20, 20))
        buttons.pack()

        actions = [
            ("Add Book", lambda: AddBookDialog(self)),
            ("Borrow Book", lambda: BorrowBookDialog(self)),
            ("Return Book", lambda: ReturnBookDialog(self)),
            ("Search by Book", lambda: SearchByBookDialog(self)),
            ("Search by Student", lambda: SearchByStudentDialog(self)),
            ("List All Books", lambda: ListAllBooksDialog(self)),
            ("Full History", lambda: FullHistoryDialog(self)),
            ("Exit", self.destroy),
        ]

        for i, (label, command) in enumerate(actions):
            row, col = divmod(i, 2)
            ttk.Button(buttons, text=label, width=20, command=command).grid(
                row=row, column=col, padx=6, pady=6
            )


def main():
    initialize_database()
    app = LibraryApp()
    app.mainloop()


if __name__ == "__main__":
    main()