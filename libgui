class AddBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Add a New Book")
        self.resizable(False, False)
        self.transient(parent)

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book name:").grid(row=0, column=0, sticky="e", pady=4)
        self.name_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.name_var, width=30).grid(row=0, column=1, pady=4)

        ttk.Label(form, text="Author:").grid(row=1, column=0, sticky="e", pady=4)
        self.author_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.author_var, width=30).grid(row=1, column=1, pady=4)

        ttk.Button(form, text="Add Book", command=self.save).grid(
            row=2, column=0, columnspan=2, pady=(10, 0)
        )

    def save(self):
        name = self.name_var.get().strip()
        author = self.author_var.get().strip()
        if not name or not author:
            messagebox.showwarning("Missing info", "Please enter both a book name and an author.")
            return
        add_book_db(name, author)
        messagebox.showinfo("Success", f'"{name}" by {author} added to the library.')
        self.name_var.set("")
        self.author_var.set("")


class BorrowBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Borrow a Book")
        self.resizable(False, False)
        self.transient(parent)

        self.books = get_all_books_db()
        book_labels = [f"{name} (by {author})" for _, name, author in self.books]

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book:").grid(row=0, column=0, sticky="e", pady=4)
        self.book_var = tk.StringVar()
        book_combo = ttk.Combobox(form, textvariable=self.book_var, values=book_labels,
                                   width=32, state="readonly")
        book_combo.grid(row=0, column=1, pady=4)
        if book_labels:
            book_combo.current(0)

        ttk.Label(form, text="Student name:").grid(row=1, column=0, sticky="e", pady=4)
        self.student_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.student_var, width=30).grid(row=1, column=1, pady=4)

        ttk.Label(form, text="Student class:").grid(row=2, column=0, sticky="e", pady=4)
        self.class_var = tk.StringVar()
        ttk.Entry(form, textvariable=self.class_var, width=30).grid(row=2, column=1, pady=4)

        ttk.Label(form, text="Borrow date:").grid(row=3, column=0, sticky="e", pady=4)
        self.date_entry = DateEntry(form)
        self.date_entry.grid(row=3, column=1, sticky="w", pady=4)

        ttk.Button(form, text="Log Borrow", command=self.save).grid(
            row=4, column=0, columnspan=2, pady=(10, 0)
        )

        if not self.books:
            messagebox.showinfo("No books", "There are no books in the library yet. Add one first.")

    def save(self):
        if not self.books:
            return
        idx = self.book_var.get()
        selection = None
        for book, label in zip(self.books, [f"{n} (by {a})" for _, n, a in self.books]):
            if label == idx:
                selection = book
                break
        if not selection:
            messagebox.showwarning("No book selected", "Please choose a book.")
            return

        student_name = self.student_var.get().strip()
        student_class = self.class_var.get().strip()
        if not student_name or not student_class:
            messagebox.showwarning("Missing info", "Please enter the student's name and class.")
            return

        book_id, book_name, _ = selection
        borrow_book_db(book_id, student_name, student_class, self.date_entry.get())
        messagebox.showinfo(
            "Success",
            f'"{book_name}" borrowed by {student_name} ({student_class}) '
            f'on {self.date_entry.get()}.'
        )
        self.student_var.set("")
        self.class_var.set("")


class ReturnBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Return a Book")
        self.resizable(False, False)
        self.transient(parent)

        self.books = get_all_books_db()
        book_labels = [f"{name} (by {author})" for _, name, author in self.books]

        form = ttk.Frame(self, padding=15)
        form.pack()

        ttk.Label(form, text="Book:").grid(row=0, column=0, sticky="e", pady=4)
        self.book_var = tk.StringVar()
        self.book_combo = ttk.Combobox(form, textvariable=self.book_var, values=book_labels,
                                        width=32, state="readonly")
        self.book_combo.grid(row=0, column=1, pady=4)
        self.book_combo.bind("<<ComboboxSelected>>", self.refresh_students)

        ttk.Label(form, text="Borrowed by:").grid(row=1, column=0, sticky="e", pady=4)
        self.record_var = tk.StringVar()
        self.record_combo = ttk.Combobox(form, textvariable=self.record_var,
                                          width=32, state="readonly")
        self.record_combo.grid(row=1, column=1, pady=4)

        ttk.Label(form, text="Return date:").grid(row=2, column=0, sticky="e", pady=4)
        self.date_entry = DateEntry(form)
        self.date_entry.grid(row=2, column=1, sticky="w", pady=4)

        ttk.Button(form, text="Log Return", command=self.save).grid(
            row=3, column=0, columnspan=2, pady=(10, 0)
        )

        self.open_records = []
        if book_labels:
            self.book_combo.current(0)
            self.refresh_students()
        else:
            messagebox.showinfo("No books", "There are no books in the library yet.")

    def refresh_students(self, event=None):
        idx = self.book_combo.current()
        if idx < 0:
            return
        book_id = self.books[idx][0]
        self.open_records = get_open_records_for_book_db(book_id)
        labels = [f"{sname} ({sclass}) - borrowed {bdate}"
                  for _, sname, sclass, bdate in self.open_records]
        self.record_combo["values"] = labels
        if labels:
            self.record_combo.current(0)
        else:
            self.record_var.set("")

    def save(self):
        record_idx = self.record_combo.current()
        if record_idx < 0 or not self.open_records:
            messagebox.showwarning("Nothing to return",
                                    "This book has no outstanding (un-returned) loans.")
            return
        record_id, student_name, student_class, _ = self.open_records[record_idx]
        return_book_db(record_id, self.date_entry.get())
        messagebox.showinfo(
            "Success",
            f'Return logged for {student_name} ({student_class}) on {self.date_entry.get()}.'
        )
        self.refresh_students()


class SearchByBookDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Search by Book Name")
        self.geometry("620x400")
        self.transient(parent)

        top = ttk.Frame(self, padding=10)
        top.pack(fill="x")
        ttk.Label(top, text="Book name:").pack(side="left")
        self.query_var = tk.StringVar()
        entry = ttk.Entry(top, textvariable=self.query_var, width=30)
        entry.pack(side="left", padx=6)
        entry.bind("<Return>", lambda e: self.search())
        ttk.Button(top, text="Search", command=self.search).pack(side="left")

        self.results_frame = ttk.Frame(self, padding=(10, 0, 10, 10))
        self.results_frame.pack(fill="both", expand=True)

        entry.focus()

    def search(self):
        for widget in self.results_frame.winfo_children():
            widget.destroy()

        query = self.query_var.get().strip()
        matches = find_books_by_name_db(query)
        if not matches:
            ttk.Label(self.results_frame, text=f'No book found matching "{query}".').pack(pady=20)
            return

        flattened = []
        for book_id, name, author in matches:
            history = get_history_for_book_db(book_id)
            if not history:
                flattened.append((name, author, "-", "-", "-", None))
            for sname, sclass, bdate, rdate in history:
                flattened.append((name, author, sname, sclass, bdate, rdate))

        build_history_table(self.results_frame, flattened)


class SearchByStudentDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Search by Student Name")
        self.geometry("620x400")
        self.transient(parent)

        top = ttk.Frame(self, padding=10)
        top.pack(fill="x")
        ttk.Label(top, text="Student name:").pack(side="left")
        self.query_var = tk.StringVar()
        entry = ttk.Entry(top, textvariable=self.query_var, width=30)
        entry.pack(side="left", padx=6)
        entry.bind("<Return>", lambda e: self.search())
        ttk.Button(top, text="Search", command=self.search).pack(side="left")

        self.results_frame = ttk.Frame(self, padding=(10, 0, 10, 10))
        self.results_frame.pack(fill="both", expand=True)

        entry.focus()

    def search(self):
        for widget in self.results_frame.winfo_children():
            widget.destroy()

        query = self.query_var.get().strip()
        records = search_by_student_db(query)
        if not records:
            ttk.Label(self.results_frame,
                      text=f'No borrowing history found for "{query}".').pack(pady=20)
            return

        build_history_table(self.results_frame, records)


class ListAllBooksDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("All Books")
        self.geometry("400x400")
        self.transient(parent)

        frame = ttk.Frame(self, padding=10)
        frame.pack(fill="both", expand=True)

        books = get_all_books_db()
        if not books:
            ttk.Label(frame, text="No books in the library yet.").pack(pady=20)
            return

        tree = ttk.Treeview(frame, columns=("name", "author"), show="headings", height=15)
        tree.heading("name", text="Book Name")
        tree.heading("author", text="Author")
        tree.column("name", width=220)
        tree.column("author", width=150)
        for _, name, author in books:
            tree.insert("", "end", values=(name, author))

        scrollbar = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=scrollbar.set)
        tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")


class FullHistoryDialog(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.title("Full Borrow / Return History")
        self.geometry("700x420")
        self.transient(parent)

        frame = ttk.Frame(self, padding=10)
        frame.pack(fill="both", expand=True)

        records = get_full_history_db()
        if not records:
            ttk.Label(frame, text="No borrow/return history yet.").pack(pady=20)
            return

        build_history_table(frame, records)


